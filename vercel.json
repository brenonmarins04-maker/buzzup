{
  "rewrites": [
    {
      "source": "/sb-proxy/auth/v1/admin/:path*",
      "destination": "/api/deny"
    },
    {
      "source": "/sb-proxy/:path*",
      "destination": "https://twwcnudhfvzbkdrtfmtu.supabase.co/:path*"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api/asset-missing"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
